# Spool escrito pela API .NET — o ETL só lê o que está em ready/
SPOOL_PATH=../spool

# RPC HTTP: usado APENAS por backfill histórico e reconciliação de lacunas.
# A assinatura ao vivo (newHeads) é da API .NET. Não abra outra aqui.
ALCHEMY_HTTP_URL=

# ClickHouse de infra/
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=alphractal
CLICKHOUSE_USER=alphractal_etl
CLICKHOUSE_PASSWORD=
