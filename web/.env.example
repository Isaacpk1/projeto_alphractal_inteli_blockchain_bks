# Base da API .NET. Em dev, deixe vazio para usar o proxy do Vite.
VITE_API_BASE_URL=

# A API real e o padrao. Use "true" apenas para demonstracao offline.
VITE_USE_MOCK=false

# Rota de entrada. Vazio abre a primeira metrica de Fees (caminho frio).
# Na demo publica sem ClickHouse, use /real-time-gas.
VITE_HOME_ROUTE=
