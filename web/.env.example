# Base da API .NET. Em dev, deixe vazio para usar o proxy do Vite.
VITE_API_BASE_URL=

# A API ainda não existe — por padrão o front roda com o transporte MOCKADO
# (lib/mock/), que simula a Mainnet: um bloco a cada 12 s, EIP-1559 de verdade.
# Quando a API .NET subir, defina como "false" para falar com ela. Nada mais muda.
VITE_USE_MOCK=
